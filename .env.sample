# --- LLM 凭证(三种来源,按需配置) ---
# 1) 由 Claude Code / OpenCode 会话调用 aj 时:以下变量从会话环境自动继承,无需配置
#    - Claude Code API key / 网关令牌: ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN 自动继承
#    - Claude Code setup-token 会话: CLAUDE_CODE_OAUTH_TOKEN 自动继承(litellm 识别 sk-ant-oat*)
#    - Claude Code Pro/Max 订阅登录(/login): 凭证不导出到子进程,需 setup-token 或显式配置
#    - OpenCode: 凭证不导出,推荐 opencode-llm-proxy 插件 + --base-url,或在启动 shell 显式 export
# 2) 独立运行:复制本文件为 .env 并填写
# 3) 本地网关:用 --base-url 或 ANTHROPIC_BASE_URL 指向 Anthropic 兼容网关

ANTHROPIC_API_KEY="sk-ant-***"
# ANTHROPIC_AUTH_TOKEN="..."      # 备选 Anthropic 令牌(网关/代理场景,与上二选一)
# CLAUDE_CODE_OAUTH_TOKEN="..."   # claude setup-token 产生的长期令牌(sk-ant-oat*)
# ANTHROPIC_BASE_URL="..."        # Anthropic 兼容网关地址
OPENAI_API_KEY="sk-***"           # meta-reviewer-2(GPT-4o)需要;未配置时该 reviewer 降级
