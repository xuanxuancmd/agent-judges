# --- LLM 凭证(三种来源,按需配置) ---
# 1) 由 Claude Code / OpenCode 会话调用 aj 时:以下变量从会话环境自动继承,无需配置
# 2) 独立运行:复制本文件为 .env 并填写
# 3) 本地网关:用 --base-url 或 ANTHROPIC_BASE_URL 指向 Anthropic 兼容网关

ANTHROPIC_API_KEY="sk-ant-***"
# ANTHROPIC_AUTH_TOKEN="..."      # 备选 Anthropic 令牌(网关/代理场景,与上二选一)
# ANTHROPIC_BASE_URL="..."        # Anthropic 兼容网关地址
OPENAI_API_KEY="sk-***"           # meta-reviewer-2(GPT-4o)需要;未配置时该 reviewer 降级
